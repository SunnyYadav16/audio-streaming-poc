WHISPER_MODEL=small           # Faster-Whisper model size (tiny|base|small|medium|large)
NLLB_MODEL=facebook/nllb-200-distilled-1.3B

# --- LLaMA 4 Legal Context Verifier (optional) ---
# Leave these unset to disable the legal verification layer entirely.
#
# Step 1: Enable Vertex AI API in your GCP project
#         https://console.cloud.google.com/vertex-ai
# Step 2: Accept the LLaMA Community License in Model Garden
#         https://console.cloud.google.com/vertex-ai/model-garden
# Step 3: Authenticate locally:
#         gcloud auth application-default login
#
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-east5

# Model to use (scout = fast & cheap, maverick = higher quality)
LEGAL_LLM_MODEL=meta/llama-4-scout-17b-16e-instruct-maas

# Max seconds to wait for a verification response before falling back
LEGAL_VERIFY_TIMEOUT=5.0
